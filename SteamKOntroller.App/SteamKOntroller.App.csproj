<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>SteamKOntroller.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-$([System.Runtime.InteropServices.RuntimeInformation]::ProcessArchitecture.ToString().ToLowerInvariant())</RuntimeIdentifier>
    <PublishProfile Condition="Exists('Properties\PublishProfiles\win-$(Platform).pubxml')">win-$(Platform).pubxml</PublishProfile>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <EnableMsixTooling>false</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <SelfContained>false</SelfContained>
    <PublishSelfContained>false</PublishSelfContained>
    <WindowsAppSDKSelfContained>false</WindowsAppSDKSelfContained>
    <SatelliteResourceLanguages>ko-KR;en-US</SatelliteResourceLanguages>
    <RetainedRuntimeResourceLanguages>ko-KR;en-us</RetainedRuntimeResourceLanguages>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Assets\SplashScreen.scale-200.png" />
    <Content Include="Assets\LockScreenLogo.scale-200.png" />
    <Content Include="Assets\Square150x150Logo.scale-200.png" />
    <Content Include="Assets\Square44x44Logo.scale-200.png" />
    <Content Include="Assets\Square44x44Logo.targetsize-24_altform-unplated.png" />
    <Content Include="Assets\Square44x44Logo.targetsize-48_altform-lightunplated.png" />
    <Content Include="Assets\StoreLogo.png" />
    <Content Include="Assets\AppIcon.ico" />
    <Content Include="Assets\Wide310x150Logo.scale-200.png" />
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <!--
    Defining the "Msix" ProjectCapability here allows the Single-project MSIX Packaging
    Tools extension to be activated for this project even if the Windows App SDK Nuget
    package has not yet been restored.
  -->
  <ItemGroup Condition="'$(DisableMsixProjectCapabilityAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <ProjectCapability Include="Msix" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SteamKOntroller.Core\SteamKOntroller.Core.csproj" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Runtime" Version="2.0.1" />
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" Version="2.0.12" />
  </ItemGroup>

  <!--
    Defining the "HasPackageAndPublishMenuAddedByProject" property here allows the Solution
    Explorer "Package and Publish" context menu entry to be enabled for this project even if
    the Windows App SDK Nuget package has not yet been restored.
  -->
  <PropertyGroup Condition="'$(DisableHasPackageAndPublishMenuAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <HasPackageAndPublishMenu>true</HasPackageAndPublishMenu>
  </PropertyGroup>

  <!-- Publish Properties -->
  <PropertyGroup>
    <PublishReadyToRun Condition="'$(Configuration)' == 'Debug'">False</PublishReadyToRun>
    <PublishReadyToRun Condition="'$(Configuration)' != 'Debug'">True</PublishReadyToRun>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>

  <Target Name="DeleteUnusedRuntimeFiles" AfterTargets="CopyFilesToOutputDirectory;Publish">
    <ItemGroup>
      <_UnusedRuntimeFiles Include="$(TargetDir)Microsoft.Web.WebView2*.dll;$(TargetDir)WebView2Loader.dll" />
      <_UnusedRuntimeFiles Include="$(TargetDir)Microsoft.Security.Authentication.OAuth.Projection.dll" />
      <_UnusedRuntimeFiles Include="$(TargetDir)Microsoft.Windows.ApplicationModel.Background.Projection.dll" />
      <_UnusedRuntimeFiles Include="$(TargetDir)Microsoft.Windows.ApplicationModel.Background.UniversalBGTask.dll" />
      <_UnusedRuntimeFiles Include="$(TargetDir)Microsoft.Windows.ApplicationModel.DynamicDependency.Projection.dll" />
      <_UnusedRuntimeFiles Include="$(TargetDir)Microsoft.Windows.ApplicationModel.Resources.Projection.dll" />
      <_UnusedRuntimeFiles Include="$(TargetDir)Microsoft.Windows.ApplicationModel.WindowsAppRuntime.Projection.dll" />
      <_UnusedRuntimeFiles Include="$(TargetDir)Microsoft.Windows.AppLifecycle.Projection.dll" />
      <_UnusedRuntimeFiles Include="$(TargetDir)Microsoft.Windows.AppNotifications.Builder.Projection.dll" />
      <_UnusedRuntimeFiles Include="$(TargetDir)Microsoft.Windows.AppNotifications.Projection.dll" />
      <_UnusedRuntimeFiles Include="$(TargetDir)Microsoft.Windows.BadgeNotifications.Projection.dll" />
      <_UnusedRuntimeFiles Include="$(TargetDir)Microsoft.Windows.Foundation.Projection.dll" />
      <_UnusedRuntimeFiles Include="$(TargetDir)Microsoft.Windows.Management.Deployment.Projection.dll" />
      <_UnusedRuntimeFiles Include="$(TargetDir)Microsoft.Windows.Media.Capture.Projection.dll" />
      <_UnusedRuntimeFiles Include="$(TargetDir)Microsoft.Windows.PushNotifications.Projection.dll" />
      <_UnusedRuntimeFiles Include="$(TargetDir)Microsoft.Windows.Security.AccessControl.Projection.dll" />
      <_UnusedRuntimeFiles Include="$(TargetDir)Microsoft.Windows.Storage.Pickers.Projection.dll" />
      <_UnusedRuntimeFiles Include="$(TargetDir)Microsoft.Windows.Storage.Projection.dll" />
      <_UnusedRuntimeFiles Include="$(TargetDir)Microsoft.Windows.System.Power.Projection.dll" />
      <_UnusedRuntimeFiles Include="$(TargetDir)Microsoft.Windows.System.Projection.dll" />
      <_UnusedRuntimeFiles Include="$(PublishDir)Microsoft.Web.WebView2*.dll;$(PublishDir)WebView2Loader.dll" Condition="'$(PublishDir)' != ''" />
      <_UnusedRuntimeFiles Include="$(PublishDir)Microsoft.Security.Authentication.OAuth.Projection.dll" Condition="'$(PublishDir)' != ''" />
      <_UnusedRuntimeFiles Include="$(PublishDir)Microsoft.Windows.ApplicationModel.Background.Projection.dll" Condition="'$(PublishDir)' != ''" />
      <_UnusedRuntimeFiles Include="$(PublishDir)Microsoft.Windows.ApplicationModel.Background.UniversalBGTask.dll" Condition="'$(PublishDir)' != ''" />
      <_UnusedRuntimeFiles Include="$(PublishDir)Microsoft.Windows.ApplicationModel.DynamicDependency.Projection.dll" Condition="'$(PublishDir)' != ''" />
      <_UnusedRuntimeFiles Include="$(PublishDir)Microsoft.Windows.ApplicationModel.Resources.Projection.dll" Condition="'$(PublishDir)' != ''" />
      <_UnusedRuntimeFiles Include="$(PublishDir)Microsoft.Windows.ApplicationModel.WindowsAppRuntime.Projection.dll" Condition="'$(PublishDir)' != ''" />
      <_UnusedRuntimeFiles Include="$(PublishDir)Microsoft.Windows.AppLifecycle.Projection.dll" Condition="'$(PublishDir)' != ''" />
      <_UnusedRuntimeFiles Include="$(PublishDir)Microsoft.Windows.AppNotifications.Builder.Projection.dll" Condition="'$(PublishDir)' != ''" />
      <_UnusedRuntimeFiles Include="$(PublishDir)Microsoft.Windows.AppNotifications.Projection.dll" Condition="'$(PublishDir)' != ''" />
      <_UnusedRuntimeFiles Include="$(PublishDir)Microsoft.Windows.BadgeNotifications.Projection.dll" Condition="'$(PublishDir)' != ''" />
      <_UnusedRuntimeFiles Include="$(PublishDir)Microsoft.Windows.Foundation.Projection.dll" Condition="'$(PublishDir)' != ''" />
      <_UnusedRuntimeFiles Include="$(PublishDir)Microsoft.Windows.Management.Deployment.Projection.dll" Condition="'$(PublishDir)' != ''" />
      <_UnusedRuntimeFiles Include="$(PublishDir)Microsoft.Windows.Media.Capture.Projection.dll" Condition="'$(PublishDir)' != ''" />
      <_UnusedRuntimeFiles Include="$(PublishDir)Microsoft.Windows.PushNotifications.Projection.dll" Condition="'$(PublishDir)' != ''" />
      <_UnusedRuntimeFiles Include="$(PublishDir)Microsoft.Windows.Security.AccessControl.Projection.dll" Condition="'$(PublishDir)' != ''" />
      <_UnusedRuntimeFiles Include="$(PublishDir)Microsoft.Windows.Storage.Pickers.Projection.dll" Condition="'$(PublishDir)' != ''" />
      <_UnusedRuntimeFiles Include="$(PublishDir)Microsoft.Windows.Storage.Projection.dll" Condition="'$(PublishDir)' != ''" />
      <_UnusedRuntimeFiles Include="$(PublishDir)Microsoft.Windows.System.Power.Projection.dll" Condition="'$(PublishDir)' != ''" />
      <_UnusedRuntimeFiles Include="$(PublishDir)Microsoft.Windows.System.Projection.dll" Condition="'$(PublishDir)' != ''" />
      <_UnusedRuntimeFiles Include="$(PublishDir)SteamKOntroller.App.pdb;$(PublishDir)SteamKOntroller.Core.pdb" Condition="'$(PublishDir)' != ''" />
    </ItemGroup>

    <Delete Files="@(_UnusedRuntimeFiles)" TreatErrorsAsWarnings="false" />
  </Target>

  <Target Name="RemoveUnusedWinUIRuntimeResourceCultures" AfterTargets="CopyFilesToOutputDirectory;Publish">
    <ItemGroup>
      <_RetainedRuntimeResourceDirectories Include="$(TargetDir)$(RetainedRuntimeResourceLanguages.Split(';'))\" />
      <_WinUIRuntimeResourceDirectories Include="$(TargetDir)*\" />
      <_WinUIRuntimeResourceDirectories Remove="@(_RetainedRuntimeResourceDirectories)" />
    </ItemGroup>

    <RemoveDir
      Directories="@(_WinUIRuntimeResourceDirectories)"
      Condition="Exists('%(_WinUIRuntimeResourceDirectories.Identity)Microsoft.ui.xaml.dll.mui') Or Exists('%(_WinUIRuntimeResourceDirectories.Identity)Microsoft.UI.Xaml.Phone.dll.mui')" />
  </Target>

  <Target Name="CopyWinUILooseResourcesToPublishDirectory" AfterTargets="Publish" Condition="'$(PublishDir)' != ''">
    <ItemGroup>
      <_WinUIXamlResources Include="$(TargetDir)*.xbf" />
      <_WinUIPriResources Include="$(TargetDir)*.pri" />
      <_AppAssetFiles Include="$(TargetDir)Assets\**\*" />
    </ItemGroup>

    <Copy
      SourceFiles="@(_WinUIXamlResources)"
      DestinationFolder="$(PublishDir)"
      SkipUnchangedFiles="true" />
    <Copy
      SourceFiles="@(_WinUIPriResources)"
      DestinationFolder="$(PublishDir)"
      SkipUnchangedFiles="true" />
    <Copy
      SourceFiles="@(_AppAssetFiles)"
      DestinationFiles="@(_AppAssetFiles->'$(PublishDir)Assets\%(RecursiveDir)%(Filename)%(Extension)')"
      SkipUnchangedFiles="true" />
  </Target>
</Project>
