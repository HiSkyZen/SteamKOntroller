<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="SteamKOntroller.App.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:SteamKOntroller.App"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="Transparent"
    SizeChanged="Page_SizeChanged"
    mc:Ignorable="d">

    <Page.Resources>
        <Style x:Key="CardBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="18" />
        </Style>
        <Style
            x:Key="FeatureCardStyle"
            BasedOn="{StaticResource CardBorderStyle}"
            TargetType="Border">
            <Setter Property="MinHeight" Value="168" />
        </Style>
        <Style
            x:Key="StatusCardStyle"
            BasedOn="{StaticResource CardBorderStyle}"
            TargetType="Border">
            <Setter Property="MinHeight" Value="100" />
        </Style>
        <Style
            x:Key="DiagnosticCardStyle"
            BasedOn="{StaticResource CardBorderStyle}"
            TargetType="Border">
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Padding" Value="14" />
        </Style>
        <Style
            x:Key="SectionTitleStyle"
            BasedOn="{StaticResource SubtitleTextBlockStyle}"
            TargetType="TextBlock">
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>
        <Style
            x:Key="CardCaptionStyle"
            BasedOn="{StaticResource CaptionTextBlockStyle}"
            TargetType="TextBlock">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>
    </Page.Resources>

    <NavigationView
        x:Name="RootNavigation"
        AutomationProperties.AutomationId="RootNavigation"
        AutomationProperties.Name="주 탐색"
        Background="Transparent"
        CompactPaneLength="64"
        IsBackButtonVisible="Collapsed"
        IsPaneToggleButtonVisible="False"
        IsSettingsVisible="False"
        OpenPaneLength="200"
        PaneDisplayMode="LeftCompact"
        SelectionChanged="RootNavigation_SelectionChanged">
        <NavigationView.MenuItems>
            <NavigationViewItem
                x:Name="SettingsNavItem"
                AutomationProperties.AutomationId="SettingsNavItem"
                Content="설정"
                Icon="Setting"
                Tag="settings" />
            <NavigationViewItem
                x:Name="StatusNavItem"
                AutomationProperties.AutomationId="StatusNavItem"
                Content="상태"
                Icon="Play"
                Tag="status" />
            <NavigationViewItem
                x:Name="DiagnosticsNavItem"
                AutomationProperties.AutomationId="DiagnosticsNavItem"
                Content="진단"
                Icon="Document"
                Tag="diagnostics" />
        </NavigationView.MenuItems>

        <Grid
            x:Name="ContentRoot"
            Padding="32,24,32,32"
            Background="Transparent"
            RowSpacing="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    x:Name="PageTitleText"
                    VerticalAlignment="Center"
                    Style="{ThemeResource TitleTextBlockStyle}"
                    Text="설정" />

                <CommandBar
                    x:Name="PageCommandBar"
                    Grid.Column="1"
                    HorizontalAlignment="Right"
                    AutomationProperties.AutomationId="PageCommandBar"
                    AutomationProperties.Name="페이지 명령"
                    Background="Transparent"
                    DefaultLabelPosition="Right"
                    OverflowButtonVisibility="Auto">
                    <AppBarButton
                        x:Name="BridgeActionButton"
                        AutomationProperties.AutomationId="BridgeActionButton"
                        AutomationProperties.Name="브리지 끄기"
                        Click="BridgeActionButton_Click"
                        Label="브리지 끄기">
                        <AppBarButton.Icon>
                            <SymbolIcon x:Name="BridgeActionIcon" Symbol="Cancel" />
                        </AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarButton
                        AutomationProperties.AutomationId="ResetCountersButton"
                        AutomationProperties.Name="카운터 초기화"
                        Click="ResetCounters_Click"
                        Label="카운터 초기화">
                        <AppBarButton.Icon>
                            <SymbolIcon Symbol="Refresh" />
                        </AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarButton
                        AutomationProperties.AutomationId="OpenLogsButton"
                        AutomationProperties.Name="로그 폴더"
                        Click="OpenLogs_Click"
                        Label="로그 폴더">
                        <AppBarButton.Icon>
                            <SymbolIcon Symbol="Folder" />
                        </AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarButton
                        AutomationProperties.AutomationId="ExitButton"
                        AutomationProperties.Name="종료"
                        Click="Exit_Click"
                        Label="종료">
                        <AppBarButton.Icon>
                            <SymbolIcon Symbol="Cancel" />
                        </AppBarButton.Icon>
                    </AppBarButton>
                </CommandBar>
            </Grid>

            <Grid Grid.Row="1">
                <ScrollViewer
                    x:Name="SettingsView"
                    HorizontalScrollBarVisibility="Disabled"
                    HorizontalScrollMode="Disabled"
                    VerticalScrollBarVisibility="Auto"
                    VerticalScrollMode="Enabled">
                    <Grid
                        x:Name="SettingsPanel"
                        MaxWidth="1180"
                        Margin="0,0,8,0"
                        ColumnSpacing="16"
                        RowSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="SettingsColumn0" Width="*" />
                            <ColumnDefinition x:Name="SettingsColumn1" Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <InfoBar
                            x:Name="StatusInfo"
                            Grid.ColumnSpan="2"
                            AutomationProperties.AutomationId="StatusInfo"
                            AutomationProperties.LiveSetting="Polite"
                            IsOpen="True"
                            Severity="Informational" />

                        <Border
                            x:Name="BridgeSettingCard"
                            Grid.Row="1"
                            Style="{StaticResource FeatureCardStyle}">
                            <Grid RowSpacing="12">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock
                                    Style="{ThemeResource BodyStrongTextBlockStyle}"
                                    Text="입력 브리지" />
                                <TextBlock
                                    Grid.Row="1"
                                    Style="{ThemeResource BodyTextBlockStyle}"
                                    Text="Steam Keyboard 입력을 필터링하고 재주입합니다."
                                    TextWrapping="WrapWholeWords" />
                                <ToggleSwitch
                                    x:Name="BridgeSwitch"
                                    Grid.Row="2"
                                    HorizontalAlignment="Left"
                                    MinWidth="116"
                                    AutomationProperties.AutomationId="BridgeSwitch"
                                    AutomationProperties.Name="입력 브리지"
                                    OffContent="끔"
                                    OnContent="켬"
                                    Toggled="BridgeSwitch_Toggled" />
                            </Grid>
                        </Border>

                        <Border
                            x:Name="StartupSettingCard"
                            Grid.Row="1"
                            Grid.Column="1"
                            Style="{StaticResource FeatureCardStyle}">
                            <Grid RowSpacing="12">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock
                                    Style="{ThemeResource BodyStrongTextBlockStyle}"
                                    Text="Windows 로그인 시 시작" />
                                <TextBlock
                                    Grid.Row="1"
                                    Style="{ThemeResource BodyTextBlockStyle}"
                                    Text="창을 열지 않고 알림 영역에서 시작합니다."
                                    TextWrapping="WrapWholeWords" />
                                <ToggleSwitch
                                    x:Name="StartupSwitch"
                                    Grid.Row="2"
                                    HorizontalAlignment="Left"
                                    MinWidth="116"
                                    AutomationProperties.AutomationId="StartupSwitch"
                                    AutomationProperties.Name="Windows 로그인 시 시작"
                                    OffContent="끔"
                                    OnContent="켬"
                                    Toggled="StartupSwitch_Toggled" />
                            </Grid>
                        </Border>

                        <Border
                            x:Name="DiagnosticSettingCard"
                            Grid.Row="2"
                            Style="{StaticResource FeatureCardStyle}">
                            <Grid RowSpacing="12">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock
                                    Style="{ThemeResource BodyStrongTextBlockStyle}"
                                    Text="진단 로그" />
                                <TextBlock
                                    Grid.Row="1"
                                    Style="{ThemeResource BodyTextBlockStyle}"
                                    Text="상세 입력 이벤트 로그는 기본적으로 저장하지 않습니다."
                                    TextWrapping="WrapWholeWords" />
                                <ToggleSwitch
                                    x:Name="DiagnosticLoggingSwitch"
                                    Grid.Row="2"
                                    HorizontalAlignment="Left"
                                    MinWidth="116"
                                    AutomationProperties.AutomationId="DiagnosticLoggingSwitch"
                                    AutomationProperties.Name="진단 로그"
                                    OffContent="끔"
                                    OnContent="켬"
                                    Toggled="DiagnosticLoggingSwitch_Toggled" />
                            </Grid>
                        </Border>

                        <Border
                            x:Name="RetentionSettingCard"
                            Grid.Row="2"
                            Grid.Column="1"
                            Style="{StaticResource FeatureCardStyle}">
                            <Grid RowSpacing="12">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock
                                    Style="{ThemeResource BodyStrongTextBlockStyle}"
                                    Text="로그 보관 기간" />
                                <TextBlock
                                    Grid.Row="1"
                                    Style="{ThemeResource BodyTextBlockStyle}"
                                    Text="완료된 로그는 압축하고 보관 기간이 지난 로그는 삭제합니다."
                                    TextWrapping="WrapWholeWords" />
                                <StackPanel
                                    Grid.Row="2"
                                    Orientation="Horizontal"
                                    Spacing="8"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center">

                                    <NumberBox
                                        x:Name="RetentionDaysBox"
                                        Width="180"
                                        AutomationProperties.AutomationId="RetentionDaysBox"
                                        AutomationProperties.Name="로그 보관 기간"
                                        LargeChange="7"
                                        Maximum="90"
                                        Minimum="1"
                                        SmallChange="1"
                                        SpinButtonPlacementMode="Compact"
                                        ValueChanged="RetentionDaysBox_ValueChanged" />

                                    <TextBlock
                                        Text="일"
                                        Style="{ThemeResource BodyTextBlockStyle}"
                                        VerticalAlignment="Center" />

                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </ScrollViewer>

                <ScrollViewer
                    x:Name="StatusView"
                    HorizontalScrollBarVisibility="Disabled"
                    HorizontalScrollMode="Disabled"
                    Visibility="Collapsed"
                    VerticalScrollBarVisibility="Auto"
                    VerticalScrollMode="Enabled">
                    <StackPanel
                        x:Name="StatusPanel"
                        MaxWidth="1180"
                        Margin="0,0,8,0"
                        Spacing="16">
                        <Grid
                            x:Name="StatusCardsGrid"
                            ColumnSpacing="12"
                            RowSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="StatusColumn0" Width="*" />
                                <ColumnDefinition x:Name="StatusColumn1" Width="*" />
                                <ColumnDefinition x:Name="StatusColumn2" Width="*" />
                                <ColumnDefinition x:Name="StatusColumn3" Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Border x:Name="EnabledCard" Style="{StaticResource StatusCardStyle}">
                                <StackPanel Spacing="4">
                                    <TextBlock Style="{StaticResource CardCaptionStyle}" Text="브리지" />
                                    <TextBlock x:Name="EnabledText" Style="{ThemeResource SubtitleTextBlockStyle}" Text="-" />
                                </StackPanel>
                            </Border>
                            <Border x:Name="HookCard" Grid.Column="1" Style="{StaticResource StatusCardStyle}">
                                <StackPanel Spacing="4">
                                    <TextBlock Style="{StaticResource CardCaptionStyle}" Text="후크" />
                                    <TextBlock x:Name="HookText" Style="{ThemeResource SubtitleTextBlockStyle}" Text="-" />
                                </StackPanel>
                            </Border>
                            <Border x:Name="HookEventsCard" Grid.Column="2" Style="{StaticResource StatusCardStyle}">
                                <StackPanel Spacing="4">
                                    <TextBlock Style="{StaticResource CardCaptionStyle}" Text="후크 이벤트" />
                                    <TextBlock x:Name="HookEventsText" Style="{ThemeResource SubtitleTextBlockStyle}" Text="0" />
                                </StackPanel>
                            </Border>
                            <Border x:Name="CandidatesCard" Grid.Column="3" Style="{StaticResource StatusCardStyle}">
                                <StackPanel Spacing="4">
                                    <TextBlock Style="{StaticResource CardCaptionStyle}" Text="Steam 후보" />
                                    <TextBlock x:Name="CandidatesText" Style="{ThemeResource SubtitleTextBlockStyle}" Text="0" />
                                </StackPanel>
                            </Border>
                            <Border x:Name="SuppressedCard" Grid.Row="1" Style="{StaticResource StatusCardStyle}">
                                <StackPanel Spacing="4">
                                    <TextBlock Style="{StaticResource CardCaptionStyle}" Text="차단" />
                                    <TextBlock x:Name="SuppressedText" Style="{ThemeResource SubtitleTextBlockStyle}" Text="0" />
                                </StackPanel>
                            </Border>
                            <Border x:Name="ReinjectedCard" Grid.Row="1" Grid.Column="1" Style="{StaticResource StatusCardStyle}">
                                <StackPanel Spacing="4">
                                    <TextBlock Style="{StaticResource CardCaptionStyle}" Text="재주입" />
                                    <TextBlock x:Name="ReinjectedText" Style="{ThemeResource SubtitleTextBlockStyle}" Text="0" />
                                </StackPanel>
                            </Border>
                            <Border x:Name="LoopGuardCard" Grid.Row="1" Grid.Column="2" Style="{StaticResource StatusCardStyle}">
                                <StackPanel Spacing="4">
                                    <TextBlock Style="{StaticResource CardCaptionStyle}" Text="루프 방지" />
                                    <TextBlock x:Name="LoopGuardText" Style="{ThemeResource SubtitleTextBlockStyle}" Text="0" />
                                </StackPanel>
                            </Border>
                            <Border x:Name="FailuresCard" Grid.Row="1" Grid.Column="3" Style="{StaticResource StatusCardStyle}">
                                <StackPanel Spacing="4">
                                    <TextBlock Style="{StaticResource CardCaptionStyle}" Text="SendInput 실패" />
                                    <TextBlock x:Name="FailuresText" Style="{ThemeResource SubtitleTextBlockStyle}" Text="0" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Style="{StaticResource CardBorderStyle}">
                            <Grid
                                x:Name="RecentActivityGrid"
                                ColumnSpacing="20"
                                RowSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition x:Name="RecentColumn0" Width="*" />
                                    <ColumnDefinition x:Name="RecentColumn1" Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock
                                    x:Name="RecentActivityTitle"
                                    Grid.ColumnSpan="2"
                                    Style="{StaticResource SectionTitleStyle}"
                                    Text="최근 활동" />
                                <StackPanel
                                    x:Name="LastKeyPanel"
                                    Grid.Row="1"
                                    Spacing="4">
                                    <TextBlock Style="{StaticResource CardCaptionStyle}" Text="마지막 키" />
                                    <TextBlock x:Name="LastKeyText" Style="{ThemeResource BodyStrongTextBlockStyle}" Text="-" />
                                </StackPanel>
                                <StackPanel
                                    x:Name="LastEventPanel"
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    Spacing="4">
                                    <TextBlock Style="{StaticResource CardCaptionStyle}" Text="마지막 이벤트" />
                                    <TextBlock x:Name="LastEventText" Style="{ThemeResource BodyStrongTextBlockStyle}" Text="-" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <Grid
                    x:Name="DiagnosticsView"
                    Margin="0,0,8,0"
                    RowSpacing="12"
                    Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <InfoBar
                        x:Name="DiagnosticsInfo"
                        AutomationProperties.AutomationId="DiagnosticsInfo"
                        AutomationProperties.LiveSetting="Polite"
                        IsOpen="True"
                        Severity="Informational" />

                    <CommandBar
                        Grid.Row="1"
                        HorizontalAlignment="Right"
                        AutomationProperties.AutomationId="DiagnosticsCommandBar"
                        AutomationProperties.Name="진단 명령"
                        Background="Transparent"
                        DefaultLabelPosition="Right"
                        OverflowButtonVisibility="Auto">
                        <AppBarButton
                            AutomationProperties.AutomationId="OpenDiagnosticsLogsButton"
                            AutomationProperties.Name="폴더 열기"
                            Click="OpenLogs_Click"
                            Label="폴더 열기">
                            <AppBarButton.Icon>
                                <SymbolIcon Symbol="Folder" />
                            </AppBarButton.Icon>
                        </AppBarButton>
                        <AppBarButton
                            AutomationProperties.AutomationId="ClearEventsButton"
                            AutomationProperties.Name="화면 지우기"
                            Click="ClearEvents_Click"
                            Label="화면 지우기">
                            <AppBarButton.Icon>
                                <SymbolIcon Symbol="Delete" />
                            </AppBarButton.Icon>
                        </AppBarButton>
                    </CommandBar>

                    <ListView
                        x:Name="EventList"
                        Grid.Row="2"
                        AutomationProperties.AutomationId="EventList"
                        AutomationProperties.Name="진단 이벤트"
                        Background="Transparent"
                        SelectionMode="None">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:DiagnosticRecordView">
                                <Border Style="{StaticResource DiagnosticCardStyle}">
                                    <Grid ColumnSpacing="16" RowSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="128" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <StackPanel Spacing="2">
                                            <TextBlock Style="{StaticResource CardCaptionStyle}" Text="시간" />
                                            <TextBlock Text="{x:Bind Time}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="2">
                                            <TextBlock Style="{StaticResource CardCaptionStyle}" Text="동작" />
                                            <TextBlock Text="{x:Bind Action}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Spacing="2">
                                            <TextBlock Style="{StaticResource CardCaptionStyle}" Text="점수" />
                                            <TextBlock HorizontalAlignment="Right" Text="{x:Bind Score}" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Spacing="2">
                                            <TextBlock Style="{StaticResource CardCaptionStyle}" Text="단계" />
                                            <TextBlock Text="{x:Bind Stage}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="1" Spacing="2">
                                            <TextBlock Style="{StaticResource CardCaptionStyle}" Text="키 / 방향" />
                                            <TextBlock Text="{x:Bind Key}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="2" Spacing="2">
                                            <TextBlock Style="{StaticResource CardCaptionStyle}" Text="방향" />
                                            <TextBlock HorizontalAlignment="Right" Text="{x:Bind Direction}" />
                                        </StackPanel>
                                        <StackPanel
                                            Grid.Row="2"
                                            Grid.ColumnSpan="3"
                                            Spacing="2">
                                            <TextBlock Style="{StaticResource CardCaptionStyle}" Text="상세" />
                                            <TextBlock
                                                Text="{x:Bind Detail}"
                                                TextTrimming="CharacterEllipsis"
                                                TextWrapping="WrapWholeWords" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Grid>
        </Grid>
    </NavigationView>
</Page>
