<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="SteamKOntroller.App.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:SteamKOntroller.App"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    mc:Ignorable="d">

    <Page.Resources>
        <Style x:Key="CardBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="18" />
        </Style>
        <Style x:Key="SectionTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource SubtitleTextBlockStyle}">
            <Setter Property="Margin" Value="0,10,0,0" />
        </Style>
        <Style x:Key="CardCaptionStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style x:Key="CommandButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="MinWidth" Value="0" />
        </Style>
    </Page.Resources>

    <NavigationView
        x:Name="RootNavigation"
        Header="설정"
        IsBackButtonVisible="Collapsed"
        IsSettingsVisible="False"
        PaneDisplayMode="LeftCompact"
        SelectionChanged="RootNavigation_SelectionChanged">
        <NavigationView.MenuItems>
            <NavigationViewItem
                x:Name="SettingsNavItem"
                Content="설정"
                Icon="Setting"
                Tag="settings" />
            <NavigationViewItem
                x:Name="StatusNavItem"
                Content="상태"
                Icon="Play"
                Tag="status" />
            <NavigationViewItem
                x:Name="DiagnosticsNavItem"
                Content="진단"
                Icon="Document"
                Tag="diagnostics" />
        </NavigationView.MenuItems>

        <Grid Padding="36,20,36,34" RowSpacing="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid ColumnSpacing="8" HorizontalAlignment="Right">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button x:Name="BridgeActionButton" Style="{StaticResource CommandButtonStyle}" Click="BridgeActionButton_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <SymbolIcon x:Name="BridgeActionIcon" Symbol="Cancel" />
                        <TextBlock x:Name="BridgeActionText" Text="끄기" />
                    </StackPanel>
                </Button>
                <Button Grid.Column="1" Style="{StaticResource CommandButtonStyle}" Click="ResetCounters_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <SymbolIcon Symbol="Refresh" />
                        <TextBlock Text="카운터 초기화" />
                    </StackPanel>
                </Button>
                <Button Grid.Column="2" Style="{StaticResource CommandButtonStyle}" Click="OpenLogs_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <SymbolIcon Symbol="Folder" />
                        <TextBlock Text="로그 폴더" />
                    </StackPanel>
                </Button>
                <Button Grid.Column="3" Style="{StaticResource CommandButtonStyle}" Click="Exit_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <SymbolIcon Symbol="Cancel" />
                        <TextBlock Text="종료" />
                    </StackPanel>
                </Button>
            </Grid>

            <Grid Grid.Row="1">
                <ScrollViewer
                    x:Name="SettingsView"
                    VerticalScrollBarVisibility="Auto"
                    VerticalScrollMode="Enabled">
                    <Grid
                        MaxWidth="1240"
                        Margin="0,0,16,0"
                        HorizontalAlignment="Stretch"
                        RowSpacing="16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <InfoBar
                            x:Name="StatusInfo"
                            IsOpen="True"
                            Severity="Informational" />

                        <TextBlock Grid.Row="1" Text="브리지" Style="{StaticResource SectionTitleStyle}" />
                        <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}">
                            <Grid ColumnSpacing="20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="4">
                                    <TextBlock Text="입력 브리지" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                    <TextBlock
                                        Text="켜져 있으면 Steam Keyboard 입력을 필터링하고 재주입합니다."
                                        Style="{ThemeResource BodyTextBlockStyle}"
                                        TextWrapping="WrapWholeWords" />
                                </StackPanel>
                                <ToggleSwitch
                                    x:Name="BridgeSwitch"
                                    Grid.Column="1"
                                    MinWidth="150"
                                    AutomationProperties.Name="입력 브리지"
                                    OffContent="끔"
                                    OnContent="켬"
                                    Toggled="BridgeSwitch_Toggled" />
                            </Grid>
                        </Border>

                        <TextBlock Grid.Row="3" Text="시작" Style="{StaticResource SectionTitleStyle}" />
                        <Border Grid.Row="4" Style="{StaticResource CardBorderStyle}">
                            <Grid ColumnSpacing="20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Windows 로그인 시 시작" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                    <TextBlock
                                        Text="앱은 창을 열지 않고 알림 영역에서 시작합니다."
                                        Style="{ThemeResource BodyTextBlockStyle}"
                                        TextWrapping="WrapWholeWords" />
                                </StackPanel>
                                <ToggleSwitch
                                    x:Name="StartupSwitch"
                                    Grid.Column="1"
                                    MinWidth="150"
                                    AutomationProperties.Name="Windows 로그인 시 시작"
                                    OffContent="끔"
                                    OnContent="켬"
                                    Toggled="StartupSwitch_Toggled" />
                            </Grid>
                        </Border>

                        <TextBlock Grid.Row="5" Text="진단" Style="{StaticResource SectionTitleStyle}" />
                        <Border Grid.Row="6" Style="{StaticResource CardBorderStyle}">
                            <Grid RowSpacing="18">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid ColumnSpacing="20">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="영구 진단 로그" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                        <TextBlock
                                            Text="상세 입력 이벤트 로그는 기본적으로 저장하지 않습니다."
                                            Style="{ThemeResource BodyTextBlockStyle}"
                                            TextWrapping="WrapWholeWords" />
                                    </StackPanel>
                                    <ToggleSwitch
                                        x:Name="DiagnosticLoggingSwitch"
                                        Grid.Column="1"
                                        MinWidth="150"
                                        AutomationProperties.Name="영구 진단 로그"
                                        OffContent="끔"
                                        OnContent="켬"
                                        Toggled="DiagnosticLoggingSwitch_Toggled" />
                                </Grid>
                                <Grid Grid.Row="1" ColumnSpacing="20">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="180" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="로그 보관 기간" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                        <TextBlock
                                            Text="완료된 로그는 압축하고 보관 기간이 지난 로그는 삭제합니다."
                                            Style="{ThemeResource BodyTextBlockStyle}"
                                            TextWrapping="WrapWholeWords" />
                                    </StackPanel>
                                    <NumberBox
                                        x:Name="RetentionDaysBox"
                                        Grid.Column="1"
                                        AutomationProperties.Name="로그 보관 기간"
                                        Header="일"
                                        LargeChange="7"
                                        Maximum="90"
                                        Minimum="1"
                                        SmallChange="1"
                                        SpinButtonPlacementMode="Compact"
                                        ValueChanged="RetentionDaysBox_ValueChanged" />
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                </ScrollViewer>

                <ScrollViewer
                    x:Name="StatusView"
                    Visibility="Collapsed"
                    VerticalScrollBarVisibility="Auto"
                    VerticalScrollMode="Enabled">
                    <Grid
                        MaxWidth="1240"
                        Margin="0,0,16,0"
                        HorizontalAlignment="Stretch"
                        RowSpacing="16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Text="런타임" Style="{StaticResource SectionTitleStyle}" />
                        <Grid Grid.Row="1" ColumnSpacing="12" RowSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Border Style="{StaticResource CardBorderStyle}">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="브리지" Style="{StaticResource CardCaptionStyle}" />
                                    <TextBlock x:Name="EnabledText" Text="-" Style="{ThemeResource SubtitleTextBlockStyle}" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="후크" Style="{StaticResource CardCaptionStyle}" />
                                    <TextBlock x:Name="HookText" Text="-" Style="{ThemeResource SubtitleTextBlockStyle}" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="후크 이벤트" Style="{StaticResource CardCaptionStyle}" />
                                    <TextBlock x:Name="HookEventsText" Text="0" Style="{ThemeResource SubtitleTextBlockStyle}" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="3" Style="{StaticResource CardBorderStyle}">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Steam 후보" Style="{StaticResource CardCaptionStyle}" />
                                    <TextBlock x:Name="CandidatesText" Text="0" Style="{ThemeResource SubtitleTextBlockStyle}" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="차단" Style="{StaticResource CardCaptionStyle}" />
                                    <TextBlock x:Name="SuppressedText" Text="0" Style="{ThemeResource SubtitleTextBlockStyle}" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource CardBorderStyle}">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="재주입" Style="{StaticResource CardCaptionStyle}" />
                                    <TextBlock x:Name="ReinjectedText" Text="0" Style="{ThemeResource SubtitleTextBlockStyle}" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource CardBorderStyle}">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="루프 방지" Style="{StaticResource CardCaptionStyle}" />
                                    <TextBlock x:Name="LoopGuardText" Text="0" Style="{ThemeResource SubtitleTextBlockStyle}" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Row="1" Grid.Column="3" Style="{StaticResource CardBorderStyle}">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="SendInput 실패" Style="{StaticResource CardCaptionStyle}" />
                                    <TextBlock x:Name="FailuresText" Text="0" Style="{ThemeResource SubtitleTextBlockStyle}" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <TextBlock Grid.Row="2" Text="최근 활동" Style="{StaticResource SectionTitleStyle}" />
                        <Border Grid.Row="3" Style="{StaticResource CardBorderStyle}">
                            <Grid ColumnSpacing="20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="4">
                                    <TextBlock Text="마지막 키" Style="{StaticResource CardCaptionStyle}" />
                                    <TextBlock x:Name="LastKeyText" Text="-" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="4">
                                    <TextBlock Text="마지막 이벤트" Style="{StaticResource CardCaptionStyle}" />
                                    <TextBlock x:Name="LastEventText" Text="-" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </ScrollViewer>

                <Grid
                    x:Name="DiagnosticsView"
                    Margin="0,0,16,0"
                    RowSpacing="12"
                    Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <InfoBar
                        x:Name="DiagnosticsInfo"
                        IsOpen="True"
                        Severity="Informational" />

                    <Grid Grid.Row="1" ColumnSpacing="8" HorizontalAlignment="Right">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button Style="{StaticResource CommandButtonStyle}" Click="OpenLogs_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <SymbolIcon Symbol="Folder" />
                                <TextBlock Text="폴더 열기" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="1" Style="{StaticResource CommandButtonStyle}" Click="ClearEvents_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <SymbolIcon Symbol="Delete" />
                                <TextBlock Text="화면 지우기" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <ListView
                        x:Name="EventList"
                        Grid.Row="2"
                        SelectionMode="None">
                        <ListView.Header>
                            <Grid Padding="8,0,8,6" ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="70" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="시간" Style="{ThemeResource CaptionTextBlockStyle}" />
                                <TextBlock Grid.Column="1" Text="단계" Style="{ThemeResource CaptionTextBlockStyle}" />
                                <TextBlock Grid.Column="2" Text="동작" Style="{ThemeResource CaptionTextBlockStyle}" />
                                <TextBlock Grid.Column="3" Text="키" Style="{ThemeResource CaptionTextBlockStyle}" />
                                <TextBlock Grid.Column="4" Text="방향" Style="{ThemeResource CaptionTextBlockStyle}" />
                                <TextBlock Grid.Column="5" Text="점수" Style="{ThemeResource CaptionTextBlockStyle}" />
                                <TextBlock Grid.Column="6" Text="상세" Style="{ThemeResource CaptionTextBlockStyle}" />
                            </Grid>
                        </ListView.Header>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:DiagnosticRecordView">
                                <Grid Padding="8,6" ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="70" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind Time}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind Stage}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind Action}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="3" Text="{x:Bind Key}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="4" Text="{x:Bind Direction}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="5" Text="{x:Bind Score}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="6" Text="{x:Bind Detail}" TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Grid>
        </Grid>
    </NavigationView>
</Page>
